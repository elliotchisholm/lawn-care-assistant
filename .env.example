# Postgres connection string (Neon). Use the direct connection, not the pooler.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string used to sign session cookies
SESSION_SECRET=

# Password for the single login
APP_PASSWORD=

# User ID that owns all data (the existing Replit user ID when migrating)
OWNER_USER_ID=

# Optional, defaults to 5000
# PORT=5000

# Optional extra allowed origins for state-changing requests (comma-separated), e.g. a custom domain
# APP_ORIGIN=https://lawn.example.com
